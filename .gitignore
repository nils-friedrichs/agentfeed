# ---- 2026-08-27 hardening ----

# Key material. The list above named only payer-wallet.json by hand, so any
# new keyfile landed unprotected. These are generic.
*.key
*.pem
*keypair*.json

# Backup copies the *.bak- patterns miss because they have no dash after
# "bak": mcp.js.bak44, payments.js.bak44, server.js.bak44, mcp.js.bak2-<epoch>.
# These are byte copies of payments.js / server.js / mcp.js and must never be
# committed to a public repo.
*.bak[0-9]*

# Local scratch and one-off tooling. Not part of the service, kept on the box.
# Named individually rather than test-* because test-client.mjs,
# test-client-evm.mjs and test-mcp-client.mjs ARE tracked and must stay so.
probe-tools.js
shape-probe.js
patch-sharpmove.js
patch.py
build-epoch.py
build-launchledger-epoch.py
test-answer.mjs
test-squeeze.js
test-upstream.js
.tvl-helpers.snippet

# Local dataset staging. liquidations_full_20260807.csv is 123MB, over
# GitHub's 100MB hard per-file limit, so it can never be pushed from here.
hf/
exports/*.zip

# ---- 2026-09-19: MPP layer ----
# mpp/ ships its own nested node_modules (18,949 files) because mppx pins
# express>=5 as a peerOptional and this service runs express 4. The mpp/*.js
# sources ARE source and stay trackable; the vendor tree must never be one
# `git add -A` away from a public repo.
mpp/node_modules/

# macOS AppleDouble sidecars, created by tar/scp from the Mac. `._server.js`
# is a byte-carrying sidecar of a real file, so this is not cosmetic.
._*

# ---- 2026-10-08: funding radar ----
# Written by bin/funding-radar-collect.js every 5 minutes; fundingradar.db is
# covered by *.db above, the snapshot and its atomic-rename temp are not.
funding-radar.json
funding-radar.json.tmp
# options desk and macro clock snapshots (S3); options.db is covered by *.db
options.json
options.json.tmp
macro.json
macro.json.tmp

# ---- 2026-10-08: directory claim values (lib/well-known-claims.js) ----
# A verification hash or challenge token, written during a claim. Not source.
well-known/

# tools/solana2.js: mints Helius refused as too large, learned at runtime
large-mints.json
large-mints.json.tmp

# ---- 2026-10-12: Base launches (R3) ----
# Written by bin/base-launches-collect.js every minute; baselaunches.db is covered
# by *.db and its log by *.log, the snapshot and its atomic-rename temp are not.
base-launches.json
base-launches.json.tmp

# ---- 2026-10-12: Arc rail (R4) ----
# Circle payments left settlement_pending, for ops/arc-reconcile.js. Not source.
arc-pending.jsonl
arc-pending.done.jsonl
